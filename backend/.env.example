# Copy to .env and fill in. .env is git-ignored.

APP_ENV=development
DATABASE_URL=sqlite:///./proplock.db

# Signs every verified audit (HMAC). Use a long random string outside local dev.
AUDIT_SECRET=dev-only-change-me

# Only for demos: allows the demo commute table and the fake PayPal adapter.
DEMO_MODE=false

# Where uploaded photos are stored (relative to backend/). Git-ignored.
UPLOAD_DIR=uploads

# Browser origins allowed to call the API, comma-separated. The dev frontend goes through
# Vite's proxy and needs none; list a deployed frontend's origin here.
CORS_ORIGINS=http://localhost:5173

# Groq (claim extraction + photo checks). Model names are set after the Phase 0 spike.
GROQ_API_KEY=
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=

# Commute routes for Check B.
#   osm  = OpenStreetMap: free, no key or card. Walking judged fully; driving is an empty-road
#          best case (over the limit = FAIL, inside it = manager review); no transit.
#   auto = Google Routes if GOOGLE_MAPS_API_KEY is set (live traffic, needs billing),
#          else the demo table when DEMO_MODE=true, else no route data.
MAPS_PROVIDER=osm
# Optional: real peak-hour commute times (Google Routes API, needs a billing account).
GOOGLE_MAPS_API_KEY=

# Optional: PayPal sandbox app (Catalog Products).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Feature 4: invoices, webhooks and disputes use the same sandbox app.
# The webhook id from the sandbox app's Webhooks section; without it no webhook is trusted
# (in DEMO_MODE the demo script signs its own events instead).
PAYPAL_WEBHOOK_ID=
INVOICE_CURRENCY=USD
INVOICE_DUE_DAYS=7
INVOICE_REMINDER_OFFSETS=-1,1,3

# Feature 2: visit booking. The fee is a PayPal authorization hold (INVOICE_CURRENCY), not a charge.
VISIT_FEE_BASE=15.00
VISIT_FEE_EARLY_DISCOUNT_PCT=20
VISIT_FEE_LATE_SURCHARGE_PCT=30
VISIT_WINDOW_DAYS=3
VISIT_SOFT_HOLD_MINUTES=15
VISIT_TRANSIT_BUFFER_MINUTES=30
VISIT_HOURS=9-18
VISIT_UTC_OFFSET_MINUTES=330
